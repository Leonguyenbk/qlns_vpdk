# ================================
# Cấu hình môi trường Backend
# ================================
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret

# Thời hạn token (giây)
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=1209600

# Kết nối MySQL 8 (utf8mb4)
DATABASE_URL=mysql+pymysql://hr_user:change-this-database-password@localhost:3306/personnel_management?charset=utf8mb4

# CORS: danh sách origin cho phép, phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Giới hạn đăng nhập sai
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Ghi log
LOG_LEVEL=INFO

# Tài khoản quản trị khởi tạo (script create_admin.py)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_RESET_PASSWORD=false
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Quản trị hệ thống
