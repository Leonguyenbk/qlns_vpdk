# ================================================================
#  Cấu hình môi trường Backend — PLATFORM (goiso + nhân sự)
#  Sao chép thành backend/.env và điền giá trị thật. KHÔNG commit .env.
# ================================================================
FLASK_ENV=development
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret

# Thời hạn token (giây)
JWT_ACCESS_TOKEN_EXPIRES=900
JWT_REFRESH_TOKEN_EXPIRES=1209600

# Kết nối MySQL 8 (utf8mb4) — một CSDL dùng chung cho cả platform
DATABASE_URL=mysql+pymysql://user:password@localhost:3306/qlns_platform?charset=utf8mb4

# CORS: danh sách origin cho phép, phân tách bằng dấu phẩy
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5050

# Tên miền (điền khi triển khai thật — Phase 8).
#   APP_DOMAIN    : tên miền gốc, ví dụ  vpdk.example.vn
#   COOKIE_DOMAIN : để trống khi chạy localhost; đặt .example.vn nếu dùng subdomain
APP_DOMAIN=
COOKIE_DOMAIN=

# Giới hạn đăng nhập sai
LOGIN_MAX_FAILED_ATTEMPTS=5
LOGIN_LOCKOUT_MINUTES=15

# Ghi log
LOG_LEVEL=INFO

# Tài khoản quản trị khởi tạo (script create_admin.py / flask create-admin)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_RESET_PASSWORD=false
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Quản trị hệ thống

# --- Module goiso (dùng từ Phase 3) ---
# Đường dẫn CSDL SQLite goiso hiện hữu (chỉ dùng khi chưa migrate sang MySQL).
GOISO_DB=D:/QUANGTUAN/goiso_kios/hethong_v2.db
# Cloudflare Turnstile cho trang đặt lịch online (theo tên miền — cấp lại khi đổi domain)
TURNSTILE_SITE_KEY=
TURNSTILE_SECRET=
# Giọng đọc số mặc định (edge-tts)
TTS_VOICE=vi-VN-HoaiMyNeural
