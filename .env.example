# ============================================================
#  Biến môi trường dùng cho docker-compose (sao chép thành .env)
# ============================================================

# --- MySQL ---
# Bắt buộc đổi các giá trị mật khẩu/secret trước khi triển khai thật.
MYSQL_ROOT_PASSWORD=change-this-root-password
MYSQL_DATABASE=personnel_management
MYSQL_USER=hr_user
MYSQL_PASSWORD=change-this-database-password
MYSQL_PORT=3306

# --- Backend ---
BACKEND_PORT=5000
SECRET_KEY=replace-with-a-long-random-secret
JWT_SECRET_KEY=replace-with-another-long-random-secret
CORS_ORIGINS=http://localhost:5173,http://localhost:8080

# Seed dữ liệu mẫu khi container backend khởi động lần đầu
SEED_ON_START=true

# Tùy chọn: import file "Phụ lục 4" thật lúc khởi động.
#   1. Copy file .xlsx vào thư mục  ./backend/data/  (đã .gitignore, không lên git)
#   2. Bỏ chú thích dòng dưới, trỏ tới đường dẫn TRONG container (/data/<tên file>)
#   3. Nên đặt SEED_ON_START=false để không lẫn dữ liệu mẫu
# IMPORT_PHULUC4=/data/Phu luc 4.xlsx

# Tài khoản quản trị khởi tạo
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-this-admin-password
ADMIN_RESET_PASSWORD=false
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Quản trị hệ thống

# --- Frontend ---
FRONTEND_PORT=8080
